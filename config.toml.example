# Deeper Research — provider/agent config example. Copy this to ./deeper-research.toml or
# ~/.config/deeper-research/config.toml and fill in your keys. The COPY holds secrets and
# is gitignored; do NOT put real keys in this example file.
# Augments ~/.env: built-in providers (claude/chatgpt/gemini/grok) still work
# from env keys; entries here add or override providers and remap agent types.
#
# MODEL-ID DRIFT: provider model IDs change. Always verify the current ID on the
# provider's site; the examples below reflect 2026-06 but may drift. max_tokens must
# stay within each model's output cap — exceeding it causes a 400 error.

# ---------------------------------------------------------------------------
# EXAMPLE A: diverse multi-provider setup
# Principle: reach different model lineages; avoid paying a middleman for models
# you can get cheaper direct.
# ---------------------------------------------------------------------------

# DeepSeek direct — cheaper than via OpenRouter for DeepSeek models
[providers.deepseek]
api_type   = "openai"
api_key    = "sk-xxxx"                     # or: api_key_env = "DEEPSEEK_KEY"
base_url   = "https://api.deepseek.com/v1"
model      = "deepseek-v4-pro"             # also deepseek-v4-flash (cheaper); legacy
                                            # deepseek-chat/deepseek-reasoner retire 2026-07-24
max_tokens = 32768
pricing    = { in = 0.55, out = 2.19 }
family     = "other"                        # model lineage; drives adversary selection
                                            # (must differ from the actual synthesis executor)

# OpenRouter — best for reaching model lineages you can't get direct
# (Kimi/GLM/Microsoft etc). Not the cheapest path for DeepSeek or Anthropic.
[providers.kimi]
api_type   = "openai"
api_key    = "sk-or-xxxx"
base_url   = "https://openrouter.ai/api/v1"
model      = "moonshotai/kimi-k2.6"        # verify current id at openrouter.ai/models
max_tokens = 32768
family     = "other"

# Fireworks — account-scoped model IDs
[providers.glm]
api_type   = "openai"
api_key    = "fw_xxxx"
base_url   = "https://api.fireworks.ai/inference/v1"
model      = "accounts/fireworks/models/glm-5p1"   # verify current id at fireworks.ai/models
max_tokens = 32768
family     = "other"

# Subscription providers are auto-detected only when the active-host environment markers
# and matching host CLI are both available: Codex adds `codex-sub`; Claude Code adds
# `claude-sub`. The declarations below are optional overrides (for example, to add
# model/tool settings). An explicit
# `[defaults].synthesis` deliberately selects the provider that actually runs Round 2;
# omit it to use the active host's native subagent.

# Codex subscription provider — direct text calls use hardened `codex exec` with an
# ephemeral, read-only sandbox. Native Codex subagents handle orchestration.
[providers.codex-sub]
api_type = "cli"
command  = "codex"
# model  = "<current Codex model ID>"  # optional; model flags are not allowed in extra_args
# extra_args = ["--strict-config", "--color", "never"]  # only permitted Codex extras
family   = "openai"

# Claude subscription provider — live web search at $0 API cost
# claude -p blocks tools by default; --allowedTools WebSearch Bash(curl:*) opts in
# to search + curl-only fetching (no Edit/Write, no other shell commands).
# NO WebFetch: it returns an AI summary of the page, not the page — curl the raw
# page and grep/read the actual text instead. This makes it eligible for the
# real-time agent type via capabilities = ["web_search"].
[providers.claude-sub]
api_type     = "cli"
command      = "claude"
# model      = "<current Claude alias or ID>"       # optional; omit to use CLI default
extra_args   = ["--allowedTools", "WebSearch", "Bash(curl:*)"]
capabilities = ["web_search"]                     # marks it real-time-eligible
family       = "anthropic"                         # same lineage as the metered `claude` built-in;
                                                    # non-independent adversaries are skipped

# One-off calls — active-host subscription preference applies automatically for utility
# work. Uncommenting `synthesis` changes Round 2: it becomes the actual executor, and
# adversary selection compares against that provider's family. Every nonempty explicit
# role is authoritative: an unavailable named provider is a configuration error, never
# a request to fall back to the host subscription or a metered provider.
# [defaults]
# utility = "codex-sub"    # or "claude-sub"; explicit defaults win over auto-detection
# synthesis = "codex-sub"  # explicit executor; omit to use native host synthesis

# ---------------------------------------------------------------------------
# Run configuration (Round-1 retrieval + adversary). All keys optional — omit
# the whole [run] table to accept the code defaults shown here.
# ---------------------------------------------------------------------------
# [run]
# mode                = "slices"   # the only supported mode; any other value errors
# max_retrieval_usd   = 1.0        # per-run hard money cap on Exa retrieval
# agent_scout_usd     = 10.0       # cap for the one Exa Agent ultra scout (own ledger); 0 = off
# min_evidence_total  = 10         # gate: minimum globally-unique evidence items
# min_nonempty_slices = 2          # gate: minimum slices that returned ≥1 item
# adversary           = ["grok", "chatgpt", "gemini"]  # walked in order; the first
#                                  # configured + available independent provider becomes
#                                  # the adversary. Families must differ, and OpenAI ↔ xAI
#                                  # is also excluded because of common-corpus risk. If
#                                  # none qualify, independent review is fail-closed: do
#                                  # not report it as satisfied; configure an independent provider.

# ---------------------------------------------------------------------------
# Round-1 slice roster. Omit all [slices.*] tables to accept the 5-slice code
# default. Each slice sets EITHER `category` (an Exa category enum) OR
# `include_domains` (a domain allowlist) — never both (they are XOR).
# ---------------------------------------------------------------------------
# [slices.publication]
# query    = "{topic}"                     # {topic} is substituted at run time
# category = "research paper"
# enabled  = true

# [slices.news]
# query    = "{topic} latest developments"
# category = "news"
# enabled  = true

# [slices.institutional]
# query           = "{topic} policy report analysis"
# include_domains = ["oecd.org", "worldbank.org", "imf.org", "un.org", "brookings.edu"]
# enabled         = true

# [slices.financial]
# query    = "{topic} financial analysis"
# category = "financial report"
# enabled  = false

# [slices.personal-site]
# query           = "{topic}"
# include_domains = ["substack.com", "medium.com"]
# enabled         = false

# Agent mappings — deliberate diverse spread across model lineages. Built-in defaults
# apply when omitted; choose `codex-sub` in Codex or `claude-sub` in Claude Code only
# when deliberately overriding the automatic active-host selection.
# [agents.academic]
# provider = "codex-sub"

# [agents.real-time]
# provider = "claude-sub"  # Claude-only web-search opt-in; retrieval remains Exa

[agents.grey-literature]
provider = "deepseek"

[agents.contrarian]
provider = "kimi"

# ---------------------------------------------------------------------------
# EXAMPLE B: minimal cli-only setup (subscription, no API keys needed)
# ---------------------------------------------------------------------------

# [providers.codex-sub]
# api_type = "cli"
# command  = "codex"
# family   = "openai"

# [providers.claude-sub]
# api_type = "cli"
# command  = "claude"
# extra_args = ["--allowedTools", "WebSearch", "Bash(curl:*)"]
# capabilities = ["web_search"]

# [agents.academic]
# provider = "codex-sub"  # use `claude-sub` when the active host is Claude Code

# [agents.real-time]
# provider = "claude-sub"

